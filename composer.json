{
    "name": "permitcore/sdk",
    "description": "Official PHP client for PermitCore license management. Validate, activate, and deactivate license keys with built-in hardware fingerprinting and offline grace period caching.",
    "type": "library",
    "license": "MIT",
    "keywords": ["license", "licensing", "sdk", "permitcore", "activation"],
    "homepage": "https://permitcore.dev",
    "authors": [
        { "name": "PermitCore", "email": "sdk@permitcore.dev" }
    ],
    "support": {
        "source": "https://github.com/permitCore-spec/permitcore-sdk-php",
        "docs": "https://permitcore.dev/docs/sdks/php"
    },
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-4": {
            "PermitCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PermitCore\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "minimum-stability": "stable"
}
