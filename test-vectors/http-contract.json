      "meter": "Existing detailed MeterResult overloads retained; canonical boolean reporting is tryMeter."
    },
    "cpp": {
      "meter": "Existing detailed MeterResult signature retained; canonical boolean reporting is try_meter.",
      "build_validate_body": "Previously published pure request-builder seam retained for compatibility.",
      "build_activate_body": "Previously published pure request-builder seam retained for compatibility.",
      "parse_validate": "Previously published pure response-parser seam retained for compatibility."
