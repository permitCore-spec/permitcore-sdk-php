  "featureCases": [
    {
      "name": "none",
      "features": null,
      "feature": "export",
      "expected": false
    },
    {
      "name": "empty",
      "features": [],
      "feature": "export",
      "expected": false
    },
    {
      "name": "present",
      "features": [
        "pro",
        "export"
      ],
      "feature": "export",
      "expected": true
    },
    {
      "name": "upper-stored",
      "features": [
        "EXPORT"
      ],
      "feature": "export",
      "expected": true
    },
    {
      "name": "upper-request",
      "features": [
        "export"
      ],
      "feature": "EXPORT",
      "expected": true
    },
    {
      "name": "missing",
      "features": [
        "pro"
      ],
      "feature": "export",
      "expected": false
    },
    {
      "name": "empty-id",
      "features": [
        ""
      ],
      "feature": "",
      "expected": true
    }
  ],
  "transportCases": [
    {
      "name": "validate-recovers",
      "operation": "validate",
      "statuses": [
        503,
        503,
        200
      ],
      "body": "{\"isValid\":true,\"productName\":\"QA Product\"}",
      "expectedRequests": 3,
      "expectedSuccess": true,
      "expectedErrorCode": "",
      "expectedOffline": false
    },
    {
      "name": "validate-exhausted",
      "operation": "validate",
      "statuses": [
        503
      ],
      "body": "{\"isValid\":true,\"productName\":\"QA Product\"}",
      "expectedRequests": 3,
      "expectedSuccess": false,
      "expectedErrorCode": "RequestFailed",
      "expectedOffline": true
    },
    {
      "name": "validate-retries-disabled",
      "operation": "validate",
      "statuses": [
        503,
        200
      ],
      "body": "{\"isValid\":true,\"productName\":\"QA Product\"}",
      "expectedRequests": 1,
      "expectedSuccess": false,
      "expectedErrorCode": "RequestFailed",
      "expectedOffline": true,
      "maxRetries": 0
    },
    {
      "name": "validate-one-retry",
      "operation": "validate",
      "statuses": [
        503,
        200
      ],
      "body": "{\"isValid\":true,\"productName\":\"QA Product\"}",
      "expectedRequests": 2,
      "expectedSuccess": true,
      "expectedErrorCode": "",
      "expectedOffline": false,
      "maxRetries": 1
    },
    {
      "name": "validate-rejection",
      "operation": "validate",
      "statuses": [
        403,
        200
      ],
      "body": "{\"isValid\":true,\"productName\":\"QA Product\"}",
      "expectedRequests": 1,
      "expectedSuccess": false,
      "expectedErrorCode": "HttpError",
      "expectedOffline": false
    },
    {
      "name": "validate-redirect",
      "operation": "validate",
      "statuses": [
        302
      ],
      "body": "{\"isValid\":true,\"productName\":\"QA Product\"}",
      "expectedRequests": 1,
      "expectedSuccess": false,
      "expectedErrorCode": "HttpError",
      "expectedOffline": false,
      "location": "/redirect-target"
    },
    {
      "name": "validate-malformed",
      "operation": "validate",
      "statuses": [
        200
      ],
      "body": "{",
      "expectedRequests": 1,
      "expectedSuccess": false,
      "expectedErrorCode": "InvalidResponse",
      "expectedOffline": false,
      "cacheAvailable": true
    },
    {
      "name": "validate-missing",
      "operation": "validate",
      "statuses": [
        200
      ],
      "body": "{}",
      "expectedRequests": 1,
      "expectedSuccess": false,
      "expectedErrorCode": "InvalidResponse",
      "expectedOffline": false,
      "cacheAvailable": true
    },
    {
      "name": "validate-null",
      "operation": "validate",
      "statuses": [
        200
      ],
      "body": "null",
      "expectedRequests": 1,
      "expectedSuccess": false,
      "expectedErrorCode": "InvalidResponse",
      "expectedOffline": false,
      "cacheAvailable": true
    },
    {
      "name": "validate-array",
      "operation": "validate",
      "statuses": [
        200
      ],
      "body": "[]",
      "expectedRequests": 1,
      "expectedSuccess": false,
      "expectedErrorCode": "InvalidResponse",
      "expectedOffline": false,
      "cacheAvailable": true
    },
    {
      "name": "validate-coerced",
      "operation": "validate",
      "statuses": [
        200
      ],
      "body": "{\"isValid\":\"true\"}",
      "expectedRequests": 1,
      "expectedSuccess": false,
      "expectedErrorCode": "InvalidResponse",
      "expectedOffline": false,
      "cacheAvailable": true
    },
    {
      "name": "validate-empty",
      "operation": "validate",
      "statuses": [
        200
      ],
      "body": "",
      "expectedRequests": 1,
      "expectedSuccess": false,
      "expectedErrorCode": "InvalidResponse",
      "expectedOffline": false,
      "cacheAvailable": true
    },
    {
      "name": "validate-no-content",
      "operation": "validate",
      "statuses": [
        204
      ],
      "body": "",
      "expectedRequests": 1,
      "expectedSuccess": false,
      "expectedErrorCode": "InvalidResponse",
      "expectedOffline": false,
      "cacheAvailable": true
    },
    {
      "name": "checkout-not-replayed",
      "operation": "checkout",
      "statuses": [
        503,
        503,
        200
      ],
      "body": "{\"success\":true,\"sessionToken\":\"qa-transport-token\",\"expiresAt\":\"2035-01-01T12:00:00Z\"}",
      "expectedRequests": 1,
      "expectedSuccess": false,
      "expectedErrorCode": "RequestFailed",
      "expectedOffline": false
    },
    {
      "name": "heartbeat-recovers",
      "operation": "heartbeat",
      "statuses": [
        503,
        503,
        200
      ],
      "body": "{\"success\":true,\"sessionToken\":\"qa-transport-token\",\"expiresAt\":\"2035-01-01T12:00:00Z\"}",
      "expectedRequests": 3,
      "expectedSuccess": true,
      "expectedErrorCode": "",
      "expectedOffline": false
    },
    {
      "name": "activate-not-replayed",
      "operation": "activate",
      "statuses": [
        503,
        200
      ],
      "body": "{\"isValid\":true,\"productName\":\"QA Product\"}",
      "expectedRequests": 1,
      "expectedSuccess": false,
      "expectedErrorCode": "RequestFailed",
      "expectedOffline": true,
      "expectedNonceRequests": 1
    },
    {
      "name": "nonce-recovers",
      "operation": "activate",
      "statuses": [
        200
      ],
      "body": "{\"isValid\":true,\"productName\":\"QA Product\"}",
      "expectedRequests": 1,
      "expectedSuccess": true,
      "expectedErrorCode": "",
      "expectedOffline": false,
      "nonceStatuses": [
        503,
        503,
        200
      ],
      "expectedNonceRequests": 3
    },
    {
      "name": "nonce-rejection",
      "operation": "activate",
      "statuses": [
        200
      ],
      "body": "{\"isValid\":true,\"productName\":\"QA Product\"}",
      "expectedRequests": 0,
      "expectedSuccess": false,
      "expectedErrorCode": "HttpError",
      "expectedOffline": false,
      "nonceStatuses": [
        403
      ],
      "expectedNonceRequests": 1
    },
    {
      "name": "nonce-invalid",
      "operation": "activate",
      "statuses": [
        200
      ],
      "body": "{\"isValid\":true,\"productName\":\"QA Product\"}",
      "expectedRequests": 0,
      "expectedSuccess": false,
      "expectedErrorCode": "InvalidResponse",
      "expectedOffline": false,
      "nonceBody": "{}",
      "expectedNonceRequests": 1,
      "cacheAvailable": true
    },
    {
      "name": "meter-not-replayed",
      "operation": "meter",
      "statuses": [
        503,
        200
      ],
      "body": "{\"recorded\":true}",
      "expectedRequests": 1,
      "expectedSuccess": false,
      "expectedErrorCode": "",
      "expectedOffline": false
    },
    {
      "name": "deactivate-not-replayed",
